# Test files are not needed on the build/runtime machine. (This once also kept
# api/contact.test.ts from being deployed as a live Vercel Function route; the
# api/ directory is gone, but the exclusion is still correct.) It does not affect
# local development or `npm test` — Vitest reads the working tree, not this file.
**/*.test.ts
**/*.test.tsx

# Not needed on the build/runtime machine.
e2e/
playwright-report/
test-results/
docs/
Reference/
